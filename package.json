{
  "name": "@vitoriga20/vibepm",
  "version": "0.1.0",
  "description": "一切皆插件，用 Cordis 内核重写的个人 GitHub 项目管理器（TS 版，架构照 dsh）",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "vibepm": "dist/bin.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/**/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": ["github", "project", "plugin", "cordis", "cli"]
}