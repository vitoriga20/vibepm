{
  "name": "vibepm-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "vibepm monorepo - 插件化 GitHub 项目管理器",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r --filter \"./packages/*\" run clean",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "lint": "tsc -p tsconfig.base.json --noEmit",
    "lint:hardcolor": "node scripts/verify-no-hardcolor.mjs",
    "lint:all": "pnpm run lint && pnpm run lint:hardcolor",
    "prepare": "pnpm run build",
    "release:pack": "node scripts/release.mjs pack",
    "release:verify": "node scripts/release.mjs verify",
    "release:publish": "node scripts/release.mjs publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
