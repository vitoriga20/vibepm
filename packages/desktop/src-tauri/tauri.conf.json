{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vibepm",
  "version": "0.1.0",
  "identifier": "com.vitoriga20.vibepm",
  "build": {
    "frontendDist": "./static"
  },
  "app": {
    "windows": [
      {
        "title": "vibepm island",
        "width": 210,
        "height": 36,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "maximized": false,
        "maximizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "label": "widget",
        "url": "/widget"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../sidecar/out/node.exe": "sidecar/out/node.exe",
      "../sidecar/out/server/": "sidecar/out/server/"
    }
  }
}
