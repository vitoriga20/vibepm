{
  "name": "@vitoriga20/plugin-ide-view",
  "version": "0.1.0",
  "description": "极简壳内核：VibeShell 容器 + 浏览器模块表，面板/卡片按渲染注册表数据驱动。",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=22.5.0"
  },
  "vibepm": {
    "node": {
      "inject": ["slots"],
      "provide": []
    },
    "client": {
      "inject": [],
      "provide": [],
      "immediately": true,
      "entry": "./dist/client/index.js"
    }
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "exit 0"
  },
  "dependencies": {
    "@vitoriga20/core": "workspace:*"
  }
}
