{
  "name": "@vibepm/plugin-ide-view",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "vibepm": {
    "node": {
      "inject": ["slots"],
      "provide": []
    },
    "client": {
      "inject": [],
      "provide": [],
      "immediately": true,
      "entry": "./dist/client/index.js"
    }
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "exit 0"
  },
  "dependencies": {
    "@vibepm/core": "workspace:*"
  }
}
