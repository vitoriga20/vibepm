{
  "name": "@vibepm/plugin-web-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "vibepm": {
    "node": {
      "inject": ["db", "slots", "bootGraph"],
      "provide": ["webApp", "webUrl"]
    }
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "exit 0"
  },
  "dependencies": {
    "@vibepm/core": "workspace:*"
  }
}
