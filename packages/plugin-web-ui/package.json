{
  "name": "@vitoriga20/plugin-web-ui",
  "version": "0.1.0",
  "description": "webServer 哑载体 + 静态壳：命名路由/兜底座位/index 变换，业务 API 由各插件注册。",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "static"],
  "engines": {
    "node": ">=22.5.0"
  },
  "vibepm": {
    "node": {
      "inject": ["db", "slots", "bootGraph"],
      "provide": ["webApp", "webUrl"]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "exit 0"
  },
  "dependencies": {
    "@vitoriga20/core": "workspace:*"
  }
}
