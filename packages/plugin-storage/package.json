{
  "name": "@vitoriga20/plugin-storage",
  "version": "0.1.0",
  "description": "本地 SQLite 数据库服务（db）：设置/项目/同步元数据存取。",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=22.5.0"
  },
  "vibepm": {
    "node": {
      "inject": [],
      "provide": ["db"]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "node --import tsx --test test/**/*.test.ts || exit 0"
  },
  "dependencies": {
    "@vitoriga20/core": "workspace:*",
    "@vitoriga20/plugin-web-ui": "workspace:*"
  }
}
