{
  "name": "@vibepm/plugin-skin-rhine",
  "version": "0.1.0",
  "description": "Rhine/终末地工业皮肤 for the vibepm shell — 暗色金属 + 柠檬黄。向 :root 覆盖 @VIBE-SKIN token，装上即整皮切换为终末地风，卸载即撤回科研黄黑。",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist client-dist",
    "build:ts": "tsc -b",
    "build:client": "esbuild client/index.ts --bundle --format=esm --outfile=client-dist/client.js --platform=browser --external:@vibepm/* --external:/plugins/plugin-ide-view/module-system.js",
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:client",
    "dev": "pnpm run build"
  },
  "dependencies": {
    "@vibepm/core": "workspace:*",
    "@vibepm/plugin-ide-view": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "esbuild": "^0.24.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "vibepm": {
    "id": "plugin-skin-rhine",
    "display": "Rhine // Endfield Skin",
    "role": "ui",
    "order": 12,
    "node": {
      "immediately": true,
      "inject": [],
      "provide": []
    },
    "client": {
      "entry": "./client-dist/client.js",
      "inject": [],
      "provide": [],
      "immediately": true
    },
    "configSchema": {}
  }
}